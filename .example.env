# Example Environment Variables
# Copy this file to .dev.vars (for local development) or set as Wrangler secrets (for production)

# REQUIRED: Cloudflare ImgBed URL
# Your Cloudflare ImgBed base URL (e.g., https://your-imgbed-domain.com)
IMG_BED_URL=https://your-imgbed-domain.com

# REQUIRED: Cloudflare ImgBed Authentication Code
# Your ImgBed upload authentication code
IMG_BED_AUTH_CODE=your_auth_code_here

# OPTIONAL: Upload Channel
# Default: telegram
# Options: telegram, cfr2, s3, discord, huggingface
IMG_BED_CHANNEL=telegram

# OPTIONAL: Bing Market
# Default: en-US
# Options: en-US, zh-CN, ja-JP, fr-FR, de-DE, es-ES, etc.
BING_MARKET=en-US

# OPTIONAL: Bing Wallpaper Resolution
# Default: 1920x1080
# Options: 1920x1080, UHD, 3840x2160, 2560x1440
BING_RESOLUTION=1920x1080

# OPTIONAL: Log Level
# Default: info
# Options: debug, info, warn, error
LOG_LEVEL=info

# REQUIRED for manual HTTP triggers: Trigger Token
# Protects /upload, /upload/multi, and /upload/date endpoints from unauthorized access
# Send in the Authorization header: `Authorization: Bearer your_secure_token_here`
TRIGGER_TOKEN=your_secure_token_here
